{
  "name": "trade-bot-monorepo",
  "version": "1.0.0",
  "description": "Berachain Perpetual Futures Trading Platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "engine/kodiak",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:engine\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:engine": "cd engine/kodiak && npm run dev",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend && npm run build:engine",
    "build:shared": "cd shared && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:engine": "cd engine/kodiak && npm run build",
    "test": "npm run test:backend && npm run test:frontend && npm run test:engine",
    "test:backend": "cd backend && npm run test",
    "test:frontend": "cd frontend && npm run test",
    "test:engine": "cd engine/kodiak && npm run test",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:seed": "cd backend && npm run db:seed",
    "lint": "npm run lint:backend && npm run lint:frontend && npm run lint:engine && npm run lint:shared",
    "lint:fix": "npm run lint:fix:backend && npm run lint:fix:frontend && npm run lint:fix:engine && npm run lint:fix:shared",
    "format": "npm run format:backend && npm run format:frontend && npm run format:engine && npm run format:shared",
    "format:check": "npm run format:check:backend && npm run format:check:frontend && npm run format:check:engine && npm run format:check:shared",
    "lint:backend": "cd backend && npm run lint",
    "lint:fix:backend": "cd backend && npm run lint:fix",
    "format:backend": "cd backend && npm run format",
    "format:check:backend": "cd backend && npm run format:check",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:fix:frontend": "cd frontend && npm run lint:fix",
    "format:frontend": "cd frontend && npm run format",
    "format:check:frontend": "cd frontend && npm run format:check",
    "lint:engine": "cd engine/kodiak && npm run lint",
    "lint:fix:engine": "cd engine/kodiak && npm run lint:fix",
    "format:engine": "cd engine/kodiak && npm run format",
    "format:check:engine": "cd engine/kodiak && npm run format:check",
    "lint:shared": "cd shared && npm run lint",
    "lint:fix:shared": "cd shared && npm run lint:fix",
    "format:shared": "cd shared && npm run format",
    "format:check:shared": "cd shared && npm run format:check"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=25.0.9"
  },
  "keywords": [
    "trading",
    "perpetuals",
    "berachain",
    "kodiak",
    "bot"
  ],
  "author": "",
  "license": "MIT"
}
