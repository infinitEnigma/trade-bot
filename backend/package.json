{
  "name": "@trade-bot/backend",
  "version": "1.0.0",
  "description": "Trading Platform Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../.env ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prod": "NODE_ENV=production node -r dotenv/config dist/index.js",
    "test": "jest",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:migrate:files": "node ../scripts/run-migrations.js",
    "db:reset": "npm run db:drop && npm run db:migrate:files",
    "db:drop": "ts-node scripts/drop-tables.ts",
    "db:seed": "ts-node src/database/seed.ts",
    "db:status": "ts-node scripts/migration-status.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "@trade-bot/shared": "file:../shared",
    "@types/csrf": "^1.3.2",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bs58": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.17.1",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.9",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=25.0.9"
  }
}
