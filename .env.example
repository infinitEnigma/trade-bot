# ===========================================
# TRADE-BOT ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trade_bot
DB_USER=postgres
DB_PASSWORD=your_secure_db_password

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# JWT secrets - MUST be 32+ characters in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-very-long-jwt-secret-key-change-in-production-32-chars-min
JWT_REFRESH_SECRET=your-very-long-refresh-secret-key-change-in-production-32-chars-min

# Encryption master key - MUST be 32+ characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=your-encryption-master-key-32-chars-minimum-for-production

# Bot Engine API Key - MUST be secure for server-to-server communication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_ENGINE_API_KEY=your-bot-engine-api-key-secure-server-communication

# ===========================================
# EXTERNAL APIs
# ===========================================
# Orderly Network (Kodiak) API
KODIAK_API_URL=https://api.orderly.org/v1
KODIAK_WS_URL=wss://ws-evm.orderly.org/ws/stream
ORDERLY_API_URL=https://api.orderly.org
ORDERLY_TESTNET_URL=https://testnet-api.orderly.org

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ===========================================
# CORE PURITY REFACTOR - SERVICE FEATURE FLAGS
# ===========================================
# Feature flags for gradual replacement of impure services with pure services
# Default: false (use legacy services for safety)
# Enable gradually: start with balance, then auth, then trading services

# Balance Service - High priority (frequently called, simple domain)
USE_PURE_BALANCE_SERVICE=false

# Authentication Service - Critical path (login/registration)
USE_PURE_AUTH_SERVICE=false

# Position Service - Trading critical (PnL calculations)
USE_PURE_POSITION_SERVICE=false

# Trading Services - Complex (bot management, engine)
USE_PURE_TRADING_SERVICES=false

# Bot Status Service - Critical for bot operations
USE_PURE_BOT_STATUS_SERVICE=false

# Bot Performance Service - Performance tracking and risk metrics
USE_PURE_BOT_PERFORMANCE_SERVICE=false

# API Compatibility - Return legacy format from pure services during transition
LEGACY_BALANCE_API=true
LEGACY_AUTH_API=true
LEGACY_POSITION_API=true

# ===========================================
# LIGHTER EXCHANGE (engine + phase-0 probe)
# ===========================================
# Environment: testnet (chain 300) or mainnet (chain 304)
LIGHTER_ENV=testnet
LIGHTER_BASE_URL=
LIGHTER_CHAIN_ID=300
# Account + API key (per-user; stored encrypted via the backend in production).
# Indices 0-1 are reserved for the Lighter web app - use 2+.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_PRIVATE_KEY=
# Probe / adapter knobs
LIGHTER_MARKET_SYMBOL=ETH
LIGHTER_MARKET_INDEX=
LIGHTER_PROBE_OFFSET_PCT=25
LIGHTER_PROBE_TIMEOUT_S=15
LIGHTER_PROBE_BURST=30
# Signer sidecar (sidecar/lighter-signer)
LIGHTER_SIDECAR_URL=http://127.0.0.1:8790
SIDECAR_AUTH_TOKEN=

# ===========================================
# DEVELOPMENT NOTES
# ===========================================
# 1. All secret keys MUST be changed in production
# 2. Use environment-specific values (dev/staging/prod)
# 3. Store secrets securely (AWS Secrets Manager, etc.)
# 4. Rotate keys regularly
# 5. Never use default/fallback values in production
# 6. Feature flags: Enable services gradually, monitor, rollback if needed

# ===========================================
# TRADING ENGINE (engine workspace)
# ===========================================
# Backend base URL (credential fetch + engine-to-backend API calls)
BACKEND_URL=http://localhost:3000

# Persistent engine identity. Keep ENGINE_STATE_FILE on durable storage: the
# engine id + epoch is what lets the backend reject events from superseded processes.
ENGINE_ID=
ENGINE_STATE_FILE=./.engine-state.json

# Per-bot grid slot snapshots (operational recovery cache)
GRID_SNAPSHOT_DIR=

# Engine heartbeat cadence (ms). Backend marks the engine OFFLINE after
# ENGINE_HEARTBEAT_TIMEOUT_MS (default 30000) of silence.
ENGINE_HEARTBEAT_INTERVAL_MS=10000

# Stream pending-message recovery / observability thresholds (ms / count)
PENDING_RECOVERY_MIN_IDLE_MS=60000
PENDING_STUCK_ALERT_THRESHOLD_MS=30000
PENDING_POISON_MAX_DELIVERIES=10

# ===========================================
# BACKEND SUPERVISION THRESHOLDS
# ===========================================
# A dispatched bot command must be confirmed within this window (ms)
BOT_COMMAND_TIMEOUT_MS=30000
# How often the backend's pending-event recovery pass runs (ms)
PENDING_RECOVERY_INTERVAL_MS=30000
# Stuck pending entries before a backlog warning is logged (count)
PENDING_ALERT_THRESHOLD=5
