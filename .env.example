# Backend Environment Variables
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trade_bot
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# Encryption
ENCRYPTION_MASTER_KEY=your-32-character-encryption-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Kodiak API (Berachain Mainnet)
KODIAK_API_URL=https://api-berachain.kodiak.finance/v1
KODIAK_WS_URL=wss://ws-berachain.kodiak.finance/ws/stream
KODIAK_PRIVATE_WS_URL=wss://ws-private-berachain.kodiak.finance/v2/ws/private/stream

# Bot Engine
BOT_POLL_INTERVAL=5000
