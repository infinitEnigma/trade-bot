{
  "name": "@trade-bot/shared",
  "version": "1.0.0",
  "description": "Shared TypeScript types for trade-bot",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc && tsc --project tsconfig.cjs.json && mv dist/cjs/index.js dist/index.cjs && rm -rf dist/cjs",
    "dev": "tsc --watch",
    "test": "jest"
  },
  "keywords": [
    "shared",
    "types"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
